# Ignore Python bytecode
__pycache__/
*.pyc

# Ignore virtual environments
env/
venv/

# Ignore sensitive files
*.env
config.yaml

# Ignore logs and temp files
logs/
*.log
.DS_Store

*.avi
*.mp4
*.csv
*.idea/
*.jpg
*.cpp
*.prototxt
*.caffemodel
*.png
*.mpeg
*.mpg
*.zip
*.fig

# Whitelist root and subproject images/assets used by READMEs
!images/**
!EyeBall/assets/**
!FollowThrough/assets/**
# Demo artifacts -- small, committed for zero-friction demo
!demo/data/**
!demo/static/**
# Portfolio site public assets + source (incl. icon.png / opengraph-image.png) -- shipped to Vercel
!site/public/**
!site/src/**
# iOS app assets + bundled videos (Assets.xcassets, pro shot clips, etc.)
!mobile/ios/**

# Xcode / iOS
mobile/ios/**/xcuserdata/
mobile/ios/**/*.xcuserstate
mobile/ios/**/DerivedData/
mobile/ios/**/build/
mobile/ios/**/.swiftpm/
mobile/ios/**/*.moved-aside
mobile/ios/**/*.hmap
# Carthage / CocoaPods (not used yet, but safe to pre-ignore)
mobile/ios/**/Carthage/
mobile/ios/**/Pods/

# Claude Code hygiene setup -- kept local, not committed
/.claude/
/CLAUDE.md
/WORK_NOTES.md
/CODEBASE_GUIDE.md